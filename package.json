{
  "name": "slack-inbox",
  "productName": "Slack Inbox",
  "version": "0.1.0",
  "description": "Slack as an archivable inbox: every unread thread is a message",
  "author": "Ronak Malde",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5174 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "make-icon": "electron scripts/make-icon.js",
    "make-app": "bash scripts/make-app.sh"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "fs-native-extensions": "^1.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}